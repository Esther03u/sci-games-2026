NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Signs PIN referee sessions (any random string, 32+ chars). Generate: openssl rand -hex 32
PIN_SESSION_SECRET=change-me-to-a-long-random-string
# Lets admins see a referee PIN again ("ดู PIN", migration 012). base64 of 32 random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it only means stored PINs can't be shown again — PIN login keeps working.
PIN_ENCRYPTION_KEY=
